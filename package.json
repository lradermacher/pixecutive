{
  "name": "pixecutive-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 packages apps eslint.config.ts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p packages/infrastructure && tsc -p packages/protocol && tsc -p apps/company-server && tsc -p apps/companion && tsc -p apps/office-ui && tsc -p apps/asset-pipeline",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "cspell": "10.3.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
